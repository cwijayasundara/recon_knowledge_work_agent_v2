{
  "name": "onboarding-excel-plugin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3100",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests buildcheck scripts",
    "test": "vitest run",
    "test:contract": "vitest run -c vitest.contract.config.ts",
    "audit": "pnpm audit --prod --audit-level high",
    "check": "pnpm typecheck && pnpm lint && pnpm test && node scripts/prod-build.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "manifest:swa": "node scripts/build-manifest.mjs --swa",
    "manifest:validate": "node scripts/validate-manifest.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.10.0",
    "@types/office-js": "^1.0.500",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "office-addin-manifest": "^3.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
