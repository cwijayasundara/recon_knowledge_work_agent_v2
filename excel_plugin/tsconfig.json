{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "jsxImportSource": "preact", "strict": true, "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true, "skipLibCheck": true, "types": ["office-js", "vite/client", "node"], "noEmit": true
  },
  "include": ["src", "tests", "buildcheck", "vite.config.ts", "vitest.config.ts", "vitest.contract.config.ts"]
}
