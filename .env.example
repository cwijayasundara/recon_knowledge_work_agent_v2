# Names only. Copy to .env and fill in locally; never commit values.
OPENAI_API_KEY=
ONB_MODEL_PROVIDER=openai
ONB_SUPERVISOR_MODEL=gpt-5.6-terra
ONB_RECIPE_ENGINEER_MODEL=gpt-5.6-terra
ONB_MATCHER_LLM_MODEL=gpt-5.6-terra
ONB_EMBEDDING_MODEL=text-embedding-3-small
ONB_SUPERVISOR_EFFORT=medium
ONB_RECIPE_ENGINEER_EFFORT=medium
ONB_AZURE_OPENAI_BASE_URL=
ONB_DATABASE_URL=
ONB_OBJECT_ROOT=var/objects
ONB_SANDBOX_BACKEND=docker
ONB_SANDBOX_IMAGE=onb-sandbox
ONB_ACA_POOL_ENDPOINT=
ONB_MAX_MODEL_CALLS=40
ONB_MODEL_TIMEOUT_S=120
ONB_STRING_MATCHER_PATH=../../advance_research/string_matcher_v1
ONB_API_TOKEN=
ONB_COPILOT_ENABLED=false
ONB_COPILOT_MAX_CONCURRENT_STEPS=8
