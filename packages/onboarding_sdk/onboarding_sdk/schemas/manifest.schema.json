{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Onboarding run manifest",
  "type": "object",
  "required": ["manifest_version", "run_id", "sponsor_id", "entity", "sdk_version", "upload",
               "recipe", "options", "bindings", "decisions", "findings", "outputs", "approvers",
               "created_at", "finalized_at"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "sponsor_id": {"type": "string", "minLength": 1, "not": {"const": "*"}},
    "entity": {"enum": ["affiliate"]},
    "sdk_version": {"type": "string"},
    "upload": {
      "type": "object",
      "required": ["name", "sha256"],
      "properties": {"name": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "recipe": {
      "type": "object",
      "required": ["id", "sha256", "origin"],
      "properties": {
        "id": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "origin": {"enum": ["standard", "authored", "recalled"]},
        "version": {"type": "integer"}
      }
    },
    "options": {
      "type": "object",
      "required": ["item_type", "row_item_types", "id_overrides", "excluded_rows", "acknowledged"]
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "column", "route"],
        "properties": {
          "field": {"enum": ["affiliate_id", "affiliate_name"]},
          "column": {"type": ["string", "null"]},
          "route": {"type": ["string", "null"]}
        }
      }
    },
    "decisions": {"type": "array", "items": {"type": "object", "required": ["seq", "kind", "actor", "at"]}},
    "findings": {
      "type": "object",
      "required": ["counts", "acknowledged"],
      "properties": {"counts": {"type": "object"}, "acknowledged": {"type": "array"}}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sha256", "bytes"],
        "properties": {"name": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer"}}
      }
    },
    "approvers": {
      "type": "array",
      "items": {"type": "object", "required": ["gate", "actor", "at"]}
    },
    "created_at": {"type": "string"},
    "finalized_at": {"type": ["string", "null"]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
